                );

            color: white;
        }

        .contenedor {
            width: 92%;
            max-width: 700px;

            padding: 35px 25px;

            text-align: center;

            background: rgba(0, 0, 0, 0.35);

            border: 2px solid rgba(255, 255, 255, 0.35);

            border-radius: 30px;

            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.4);

            backdrop-filter: blur(10px);
        }

        h1 {
            font-size: clamp(2rem, 8vw, 4.5rem);
            margin-bottom: 15px;
        }

        p {
            font-size: clamp(1rem, 4vw, 1.4rem);
            margin-bottom: 30px;
        }

        button {
            border: none;

            padding: 16px 32px;

            border-radius: 50px;

            background: white;
            color: #7b1e4d;

            font-size: 1.1rem;
            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;
        }

        button:hover {
            transform: scale(1.08);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        #sorpresa {
            display: none;
        }

        .mono {
            width: min(80vw, 430px);
            max-height: 430px;

            margin: 10px auto;

            display: block;

            animation: movimiento 0.6s infinite alternate;
        }

        @keyframes movimiento {
            from {
                transform: rotate(-2deg);
            }

            to {
                transform: rotate(2deg);
            }
        }

        .mensaje {
            font-size: clamp(1.5rem, 6vw, 3rem);
            font-weight: bold;

            margin-top: 10px;
